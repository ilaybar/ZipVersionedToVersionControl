<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/unobackground"
    tools:context=".InstructionsActivity">

    <TextView
        android:id="@+id/textView2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.5" />

    <TextView
        android:id="@+id/tvRecordsTable"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/bubble_font"
        android:text="Game Instructions"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="45sp" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="350sp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:fontFamily="@font/bubble_font"
                android:text="UNO Instructions"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameplay_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bubble_font"
                android:textColor="@color/white"
                android:paddingTop="16dp"
                android:text="Gameplay"
                android:textSize="26sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/gameplay_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bubble_font"
                android:textColor="@color/white"
                android:lineSpacingExtra="8dp"
                android:paddingTop="8dp"
                android:text="UNO is played with a deck of 108 cards consisting of four colors: red, green, blue, and yellow.\n\nThe deck is shuffled and each player is dealt 7 cards.\n\nThe top card of the deck is turned over to start a discard pile.\n\nThe player to the left of the dealer goes first and must match the top card of the discard pile either by color, number, or symbol (such as a draw two or reverse card).\n\nIf a player does not have a playable card, they must draw a card from the deck. If this card can be played, they may play it, otherwise their turn ends.\n\nThe first player to get rid of all their cards is the winner."
                android:textSize="20sp" />

            <TextView
                android:id="@+id/objective_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bubble_font"
                android:textColor="@color/white"
                android:text="Objective"
                android:textSize="26sp"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <TextView
                android:id="@+id/objective_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/bubble_font"
                android:textColor="@color/white"
                android:text="The objective of UNO is to be the first player to get rid of all their cards.\n\nPlayers do this by matching the top card of the discard pile with a card of the same color, number, or symbol.\n\nThere are also special cards that can be played to make the game more challenging, such as draw two cards (which forces the next player to draw two cards from the deck), skip cards (which skips the next player's turn), and reverse cards (which changes the direction of play)."
                android:textSize="20sp"
                android:lineSpacingExtra="8dp"
                android:paddingTop="8dp" />

        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/textView18"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.5"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView28"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnHomeFromInstructions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/gradient_button"
            android:fontFamily="@font/bubble_font"
            android:onClick="homeButton"
            android:text="Home"
            android:textColor="@color/white"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/textView29"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />
    </LinearLayout>

    <TextView
        android:id="@+id/textView23"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.5" />

</LinearLayout>