<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/unobackground"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/textView46"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.25" />

    <TextView
        android:id="@+id/tvWelcome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.25"
        android:fontFamily="@font/bubble_font"
        android:text="Welcome To Uno"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="45sp" />

    <TextView
        android:id="@+id/tvGameMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.25"
        android:fontFamily="@font/bubble_font"
        android:text="Start A Game Here:"
        android:textAlignment="center"
        android:textColor="@color/white"
        android:textSize="35sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.25"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.25" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnSame"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.275"
            android:background="@drawable/gradient_button"
            android:fontFamily="@font/bubble_font"
            android:onClick="gameModeChose"
            android:text="2 Players - Local"
            android:textColor="@color/white"
            android:textSize="22sp" />

        <TextView
            android:id="@+id/textView5"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.25" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.25"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/textView57"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.075" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnMoveToGameActivity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.25"
            android:background="@drawable/gradient_button"
            android:fontFamily="@font/bubble_font"
            android:onClick="moveToGameActivity"
            android:text="Start Game"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:visibility="invisible" />

        <TextView
            android:id="@+id/textView61"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="0.075" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvTip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.25"
        android:fontFamily="@font/bubble_font"
        android:gravity="center"
        android:text="Random Tip"
        android:textColor="@color/white"
        android:textSize="25sp" />

    <TextView
        android:id="@+id/textView8"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="0.3" />

</LinearLayout>